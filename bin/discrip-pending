#!/usr/bin/env python3
"""List and answer pending prompts until the web app exists (spec 8.2, 9).

  discrip-pending                         list prompts
  discrip-pending film <id> "<Name>"      file a parked film as Movies/<Name>/<Name>.mkv
  discrip-pending tv <id> [--show S] [--season N] [--first-episode E] [--year Y]
                                          confirm the season <id> belongs to: files its
                                          first waiting disc (overrides apply to the whole
                                          season) and every later disc that follows on
  discrip-pending discard <id>            delete a parked rip and its prompt
  discrip-pending known                   list remembered answers (by disc fingerprint)
  discrip-pending forget <fingerprint>    forget one, so that disc asks again
"""
import argparse
import logging
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
import discrip  # noqa: E402
import library  # noqa: E402


def hms(s):
    return f"{s // 3600}:{s // 60 % 60:02d}:{s % 60:02d}"


def show_list(cfg):
    pending = discrip.read_state(cfg)["pending"]
    if not pending:
        print("No pending prompts.")
    shown = set()
    for p in pending:
        if p["prompt"] == "tv_plan":
            if p["group"] in shown:
                continue
            shown.add(p["group"])
            members = library.season_members(cfg, p["group"])
            sug = members[0]["suggested"]
            print(f"{sug['show']} season {sug['season']}: {len(members)} disc(s) waiting"
                  f"  ->  discrip-pending tv {members[0]['id']}")
            for r in members[0].get("reasons") or []:
                print(f"  asking because {r}")
            for m in members:
                disc = m["suggested"].get("disc")
                wait = f"  (waiting for {m['waiting_for']})" if m.get("waiting_for") else ""
                print(f"  {m['id']}  disc {m['disc_label']!r}{f' #{disc}' if disc else ''}{wait}")
                for t in m["titles"]:
                    print(f"    title {t['index']:2d}  {hms(t['duration_s'])}  -> "
                          f"{t.get('proposed', '?')}")
        else:
            print(f"{p['prompt']}  {p['id']}  disc {p['disc_label']!r}")
            sug = {k: v for k, v in p["suggested"].items() if v}
            if sug:
                print("  suggested:", ", ".join(f"{k}={v}" for k, v in sug.items()))
            for t in p["titles"]:
                print(f"    title {t['index']:2d}  {hms(t['duration_s'])}")
        print()


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd")
    f = sub.add_parser("film")
    f.add_argument("id")
    f.add_argument("name")
    t = sub.add_parser("tv")
    t.add_argument("id")
    t.add_argument("--show")
    t.add_argument("--season", type=int)
    t.add_argument("--first-episode", type=int)
    t.add_argument("--year", type=int)
    d = sub.add_parser("discard")
    d.add_argument("id")
    sub.add_parser("known")
    fg = sub.add_parser("forget")
    fg.add_argument("fingerprint")
    args = ap.parse_args()

    logging.basicConfig(level=logging.INFO, format="%(message)s")
    cfg = discrip.load_config()
    try:
        if args.cmd == "film":
            print(library.answer_name_film(cfg, args.id, args.name))
        elif args.cmd == "tv":
            filed = library.answer_season(cfg, args.id, args.show, args.season,
                                          args.first_episode, args.year)
            print(f"filed {len(filed)} disc(s): {', '.join(filed)}")
            left = [p for p in discrip.read_state(cfg)["pending"] if p["prompt"] == "tv_plan"]
            if left:
                print(f"{len(left)} TV disc(s) still waiting; run discrip-pending to see why")
        elif args.cmd == "discard":
            library.discard(cfg, args.id)
        elif args.cmd == "known":
            for fp, k in library.known_discs(cfg).items():
                answer = {a: v for a, v in k.items() if a not in ("label", "updated_at")}
                print(f"{fp}  {k['label']!r}  {answer}")
        elif args.cmd == "forget":
            if not library.forget(cfg, args.fingerprint):
                raise library.PlanError(f"no known disc {args.fingerprint}")
        else:
            show_list(cfg)
    except library.PlanError as e:
        print(f"error: {e}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())

#!/usr/bin/env python3
"""Classify the disc in the drive and hand it to the right ripper (spec 6.2).

Started by discrip-watcher via discrip-rip.service. Reads the disc itself rather
than trusting udev properties: dvd-reset-auth, then cdrom_id and blkid -p.
Holds the rip lock and records the job in state.json. Video DVDs go to
lib/video.py, audio CDs to lib/audio.py.
"""
import logging
import os
import signal
import subprocess
import sys
import time
from pathlib import Path

BIN = Path(__file__).resolve().parent
sys.path.insert(0, str(BIN.parent / "lib"))
import audio  # noqa: E402
import discrip  # noqa: E402
import library  # noqa: E402
import video  # noqa: E402

log = logging.getLogger("dispatch")


def run(cmd, timeout=60):
    """Run cmd, log it, return (returncode, stdout)."""
    t0 = time.monotonic()
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        log.error("%s: timed out after %ss", cmd[0], timeout)
        return None, ""
    log.info("%s: rc=%s in %.1fs", " ".join(map(str, cmd)), r.returncode, time.monotonic() - t0)
    if r.stderr.strip():
        log.info("  stderr: %s", r.stderr.strip())
    return r.returncode, r.stdout


def export_vars(text):
    """Parse KEY=value lines (cdrom_id, blkid -o export)."""
    return dict(line.split("=", 1) for line in text.splitlines() if "=" in line)


def wait_ready(dev, timeout):
    deadline = time.monotonic() + timeout
    while True:
        try:
            code = discrip.drive_status(dev)
        except OSError as e:
            code = None
            log.warning("drive status failed: %s", e)
        if code == discrip.CDS_DISC_OK:
            return True
        if time.monotonic() > deadline:
            log.error("drive not ready after %ss (status %s)", timeout,
                      discrip.DRIVE_STATUS.get(code, code))
            return False
        time.sleep(1)


def classify(cd):
    """Media type from cdrom_id properties."""
    if cd.get("ID_CDROM_MEDIA") != "1":
        return "none"
    if any(k.startswith("ID_CDROM_MEDIA_BD") for k in cd):
        return "bluray"
    if any(k.startswith("ID_CDROM_MEDIA_DVD") or k.startswith("ID_CDROM_MEDIA_HDDVD") for k in cd):
        return "dvd"
    if int(cd.get("ID_CDROM_MEDIA_TRACK_COUNT_AUDIO", 0)) > 0:
        return "audio"
    if any(k.startswith("ID_CDROM_MEDIA_CD") for k in cd):
        return "data_cd"
    return "unknown"


PROMPT_TEXT = {
    "tv_plan": "{title} is ripped and waiting for you to confirm the episodes{why}.",
    "name_film": "A film is ripped but the disc label ({label}) is no use: give it a name.",
    "choose_titles": "{title}: not sure which titles to rip. Choose them; the disc is "
                     "still in the drive.",
}


def notify_outcome(cfg, job_id, result, error):
    """Pop up in Jellyfin when a job failed or left something to answer."""
    state = discrip.read_state(cfg)
    job = next((h for h in state["history"] if h["id"] == job_id), {})
    title = job.get("title") or "The disc"
    item = next((p for p in state["pending"] if p["id"] == job_id), None)
    if result == "error":
        library.notify(cfg, f"Rip failed: {title}: {error}")
    elif result == "ok" and error:  # done, but flagged (e.g. CD without a match)
        library.notify(cfg, f"{title}: {error}")
    elif item:
        why = ""
        if item.get("waiting_for"):
            why = f" (insert {item['waiting_for']} first)"
        elif item.get("reasons"):
            why = f" ({item['reasons'][0]})"
        library.notify(cfg, PROMPT_TEXT[item["prompt"]].format(
            title=title, label=item["disc_label"], why=why))


class Cancelled(Exception):
    pass


def on_sigterm(signum, frame):
    raise Cancelled()


def take_rerip_flag(cfg):
    """True (once) if run_dir/rerip exists: rip even if the disc is already in the
    library. Created by the web app's "rip again" (or by hand: touch it, then
    systemctl start discrip-rip)."""
    flag = Path(cfg["paths"]["run_dir"]) / "rerip"
    try:
        flag.unlink()
    except FileNotFoundError:
        return False
    log.info("rerip flag set: ripping even if already in the library")
    return True


def rip(cfg, dev, job_id):
    """Detect and rip the disc. Returns (result, error, output)."""
    if not wait_ready(dev, cfg["drive"]["ready_timeout"]):
        return "error", "no readable disc (drive never became ready)", None
    # Before anything else: stuck CSS AGIDs make MakeMKV fail with "Failed to
    # open disc". Harmless (rc=1) on a CD.
    run([BIN / "dvd-reset-auth", dev], timeout=30)

    cd = export_vars(run(["/usr/lib/udev/cdrom_id", dev])[1])
    media = classify(cd)
    fs = {}
    if media in ("dvd", "bluray", "data_cd"):
        fs = export_vars(run(["blkid", "-p", "-o", "export", dev])[1])
    label = fs.get("LABEL")
    log.info("media=%s label=%s uuid=%s fstype=%s audio_tracks=%s data_tracks=%s",
             media, label, fs.get("UUID"), fs.get("TYPE"),
             cd.get("ID_CDROM_MEDIA_TRACK_COUNT_AUDIO", 0),
             cd.get("ID_CDROM_MEDIA_TRACK_COUNT_DATA", 0))

    with discrip.state_update(cfg) as state:
        state["drive"]["media"] = media
        state["drive"]["label"] = label
    job_type = {"dvd": "video", "bluray": "video", "audio": "audio"}.get(media)
    discrip.update_job(cfg, type=job_type, title=label)

    output, eject = None, True
    if media == "bluray":
        result, error = "error", "Blu-ray not supported"
    elif job_type is None:
        result, error = "error", f"no ripper for media type {media!r}"
    elif error := discrip.check_free_space(cfg):
        result = "error"
    elif media == "dvd":
        try:
            result, error, output, eject = video.rip_dvd(
                cfg, dev, job_id, label, fs.get("UUID"), force=take_rerip_flag(cfg))
        except video.RipError as e:
            result, error = "error", str(e)
    elif media == "audio":
        # Audio tracks come first on enhanced CDs (data session last).
        tracks = int(cd.get("ID_CDROM_MEDIA_TRACK_COUNT_AUDIO", 0))
        try:
            result, error, output, eject = audio.rip_cd(cfg, dev, job_id, tracks,
                                                         force=take_rerip_flag(cfg))
        except audio.RipError as e:
            result, error = "error", str(e)

    if eject and cfg["dispatch"]["eject_when_done"]:
        discrip.update_job(cfg, stage="ejecting")
        if discrip.eject(dev):
            log.info("ejected")
        else:
            log.error("eject failed: tray did not open")
    return result, error, output


def main():
    cfg = discrip.load_config()
    job_id = time.strftime("%Y%m%d-%H%M%S")
    log_dir = Path(cfg["paths"]["state_dir"]) / "logs"
    log_dir.mkdir(parents=True, exist_ok=True)
    logging.basicConfig(level=logging.INFO, format="%(levelname)s %(message)s")
    job_log = logging.FileHandler(log_dir / f"{job_id}.log")
    job_log.setFormatter(logging.Formatter("%(asctime)s %(levelname)s %(message)s"))
    logging.getLogger().addHandler(job_log)
    log.info("job %s", job_id)

    if not os.path.ismount("/srv"):
        log.error("/srv is not mounted; refusing to run")
        return 1

    signal.signal(signal.SIGTERM, on_sigterm)
    try:
        # A short wait: the watcher takes the lock briefly at startup.
        with discrip.rip_lock(cfg, wait=5):
            stale = discrip.recover_stale_job(cfg)
            if stale:
                log.warning("job %s was interrupted at %r; marked as error",
                            stale["id"], stale["stage"])
            discrip.start_job(cfg, job_id)
            try:
                dev = discrip.find_drive(cfg)
                output = None
                if dev is None:
                    result, error = "error", "no drive found"
                else:
                    log.info("drive %s", dev)
                    result, error, output = rip(cfg, dev, job_id)
            except Cancelled:
                result, error, output = "cancelled", None, None
            except Exception as e:
                log.exception("dispatch failed")
                result, error, output = "error", f"internal error: {e}", None
            (log.info if result in ("ok", "skipped", "cancelled") else log.error)(
                "job %s: %s%s", job_id, result, f" ({error})" if error else "")
            discrip.finish_job(cfg, result, error, output)
            notify_outcome(cfg, job_id, result, error)
            return 0 if result in ("ok", "skipped", "cancelled") else 1
    except discrip.Busy:
        log.error("another rip is running; not starting")
        discrip.set_message(cfg, "A rip is already running; the new disc was not started.")
        return 1


if __name__ == "__main__":
    sys.exit(main())

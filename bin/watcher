#!/usr/bin/env python3
"""Poll the DVD drive and start the rip unit when a disc becomes ready (spec 6.1).

Every poll_interval seconds: CDROM_DRIVE_STATUS on the drive. A transition into
"ready" (including at startup) starts discrip-rip.service. The watcher never rips
itself. The poll runs in a worker thread, so a poll stuck in the kernel shows up
as "unresponsive" instead of freezing the loop; WATCHDOG=1 is sent once per loop.
"""
import concurrent.futures
import logging
import subprocess
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
import discrip  # noqa: E402

log = logging.getLogger("watcher")
HEARTBEAT = 30  # seconds between state.json writes when nothing changes


def start_rip(cfg):
    unit = cfg["dispatch"]["rip_unit"]
    if not cfg["dispatch"]["auto_start"]:
        log.info("disc ready; auto_start is off, not starting %s", unit)
        return
    active = subprocess.run(["systemctl", "is-active", "--quiet", unit]).returncode == 0
    if active:
        log.warning("disc ready but %s is already running; ignoring", unit)
        return
    r = subprocess.run(["systemctl", "start", "--no-block", unit],
                       capture_output=True, text=True)
    if r.returncode == 0:
        log.info("disc ready: started %s", unit)
    else:
        log.error("could not start %s: %s", unit, r.stderr.strip())


def poll(cfg):
    """Return (status_name, device). Raises OSError on open/ioctl failure."""
    dev = discrip.find_drive(cfg)
    if dev is None:
        return "missing", None
    code = discrip.drive_status(dev)
    return discrip.DRIVE_STATUS.get(code, f"unknown_{code}"), dev


def main():
    logging.basicConfig(level=logging.INFO, format="%(levelname)s %(message)s")
    cfg = discrip.load_config()
    interval = cfg["drive"]["poll_interval"]
    unresponsive_after = cfg["drive"]["unresponsive_after"]

    pool = concurrent.futures.ThreadPoolExecutor(max_workers=1)
    pending = None          # the in-flight poll
    last = None             # last reported status name
    last_ok = time.monotonic()
    last_write = 0.0
    error_logged = False

    discrip.sd_notify("READY=1")
    log.info("watching %s", ", ".join(cfg["drive"]["device"]))

    while True:
        if pending is None:
            pending = pool.submit(poll, cfg)
        try:
            status, dev = pending.result(timeout=interval)
            pending = None
            last_ok = time.monotonic()
            error_logged = False
        except concurrent.futures.TimeoutError:
            status, dev = None, None  # still stuck; keep waiting on the same poll
        except OSError as e:
            pending = None
            status, dev = None, None
            if not error_logged:
                log.warning("drive poll failed: %s", e)
                error_logged = True

        if status is None:
            if time.monotonic() - last_ok < unresponsive_after:
                discrip.sd_notify("WATCHDOG=1")
                time.sleep(interval if pending is None else 0)
                continue
            status = "unresponsive"

        changed = status != last
        if changed:
            log.info("drive %s: %s -> %s", dev or "-", last or "start", status)
            if status == "ready":
                start_rip(cfg)
            last = status

        if changed or time.monotonic() - last_write >= HEARTBEAT:
            with discrip.state_update(cfg) as state:
                drive = state["drive"]
                drive["present"] = status not in ("missing", "unresponsive")
                drive["status"] = status
                drive["last_poll"] = discrip.now_iso()
                if status != "ready":
                    drive["media"] = drive["label"] = None
            last_write = time.monotonic()

        discrip.sd_notify("WATCHDOG=1")
        if pending is None:
            time.sleep(interval)


if __name__ == "__main__":
    main()

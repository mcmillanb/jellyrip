// Let the discrip user start/stop the rip unit (watcher trigger, web cancel).
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "discrip-rip.service" &&
        subject.user == "@OWNER@") {
        var verb = action.lookup("verb");
        if (verb == "start" || verb == "stop" || verb == "restart") {
            return polkit.Result.YES;
        }
    }
});

// ...and shut down or restart the Pi (web app's Shut down / Restart buttons),
// even while someone is logged in over SSH.
polkit.addRule(function(action, subject) {
    if (subject.user == "@OWNER@" &&
        ["org.freedesktop.login1.power-off",
         "org.freedesktop.login1.power-off-multiple-sessions",
         "org.freedesktop.login1.reboot",
         "org.freedesktop.login1.reboot-multiple-sessions"].indexOf(action.id) >= 0) {
        return polkit.Result.YES;
    }
});
